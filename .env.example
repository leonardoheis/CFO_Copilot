# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored; never commit secrets.

# --- API & UI (optional — defaults shown) ---

# Host interface for the FastAPI server and URL templates
HOST=0.0.0.0

# FastAPI port
API_PORT=8000

# Streamlit UI port
UI_PORT=10000

# --- Data ingestion ---

# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
# Required for macro columns when running: uv run poe ingest-data --ticker AMZN
FRED_API_KEY=

# SEC EDGAR identifies clients through this header.
# Include the application name and a contact email address.
SEC_USER_AGENT=CFO Copilot you@example.com

# Alpha Vantage key used as the financials fallback (pre-XBRL history and SEC
# gaps) and for the coverage probe: uv run poe probe-alpha-vantage
ALPHA_VANTAGE_API_KEY=

# --- Experiment tracking (Weights & Biases) ---

# offline (default): runs are written locally, `wandb sync` uploads them later.
# online: needs WANDB_API_KEY. disabled: no tracking at all.
WANDB_MODE=offline
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=cfo-copilot
# Parent of the local `wandb/` run folder; defaults to the repo root (gitignored).
# WANDB_DIR=
