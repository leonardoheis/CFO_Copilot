# Copy this file to `.env` and fill in the values you need.
# `.env` is gitignored; never commit secrets.

# --- API & UI (optional — defaults shown) ---

# Host interface for the FastAPI server and URL templates
HOST=0.0.0.0

# FastAPI port
API_PORT=8000

# Streamlit UI port
UI_PORT=10000

# --- Data ingestion (required for FRED macro series) ---

# Free API key from https://fred.stlouisfed.org/docs/api/api_key.html
# Needed when running: uv run poe ingest-data --ticker AMZN
# (without --skeleton, once FredSource is implemented)
FRED_API_KEY=

# SEC EDGAR identifies clients through this header.
# Include the application name and a contact email address.
SEC_USER_AGENT=CFO Copilot you@example.com

# Alpha Vantage key for the historical coverage probe.
ALPHA_VANTAGE_API_KEY=
